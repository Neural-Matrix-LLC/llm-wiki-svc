# Copy to .env and fill in real values:  cp .env.example .env
# .env is never committed. See implement-plan.md section 6 for how to obtain each value.

# --- LLM (provider-generic) -----------------------------------------------
# These four names are the shared agentkit-llm contract: the same spelling in
# every repo that consumes the layer, so an .env moves between them unchanged.
# See implement-plan-v1.4.md section 7.6.
LLM_PROVIDER=anthropic                      # see the provider table below
LLM_API_KEY=sk-ant-...                      # whichever provider LLM_PROVIDER names
LLM_MODEL=claude-haiku-4-5                  # a model id that provider offers
LLM_BASE_URL=                               # gateway/proxy or self-hosted endpoint; blank = provider default

# Not part of the four-name agentkit-llm contract above, but still applied
# uniformly to every provider (native Anthropic and every LangChain adapter).
LLM_MAX_TOKENS=2048                         # output token cap, every completion
LLM_TEMPERATURE=1.0                         # sampling temperature; 1.0 = each provider's own default

# Providers. Anthropic is native (prompt caching and measured USD cost); the
# rest go through LangChain, which reports real token counts but no cache tier
# and no price unless the model is listed in src/llmwiki/llm/pricing.py. Every
# provider below - including its LangChain integration - is a core dependency
# (pip install llmwiki / uv sync installs all of them), so switching
# LLM_PROVIDER needs no separate install step.
#
#   LLM_PROVIDER   install       LLM_MODEL example
#   anthropic      (built in)    claude-haiku-4-5
#   openai         (built in)    gpt-5
#   vllm           (built in)    qwen2.5-14b            - self-hosted, OpenAI-compatible route
#   llamacpp       (built in)    qwen2.5-14b-gguf        - self-hosted, OpenAI-compatible route
#   google         (built in)    gemini-2.5-flash
#   nvidia         (built in)    meta/llama-3.3-70b-instruct
#   deepseek       (built in)    deepseek-chat
#   openrouter     (built in)    anthropic/claude-haiku-4.5
#   fake           (built in)    - offline double, no key needed
#
# Self-hosted (vLLM, llama.cpp): LLM_PROVIDER=vllm or LLM_PROVIDER=llamacpp
# with LLM_BASE_URL pointed at that server's OpenAI-compatible endpoint - each
# gets its own provider name (2026-09-14) rather than sharing "openai", so a
# local endpoint and real cloud OpenAI can both be configured at once. Ollama/
# LM Studio also speak this same OpenAI-compatible route; reuse whichever of
# the two names fits, or add a third row to config/providers.py if you run
# more than two local servers side by side.

# Application-specific multi-provider / per-op routing (design v1.4 4.8,
# implement-plan-v1.4.md 19) - outside the shared agentkit-llm contract above.
# Absence of the *file* at LLMWIKI_PROVIDERS_CONFIG (not of this variable) is
# what selects the single-provider fallback (LLM_PROVIDER/LLM_MODEL/etc.,
# above) - leave both unset/absent to use the fallback, which is the default.
# When both config/providers.py and config/ops.py exist, they replace
# LLM_MODEL/LLM_MAX_TOKENS/LLM_TEMPERATURE (and the old COMPILE_EXECUTOR_MODEL,
# now removed - create_page/patch_page just get their own config/ops.py rows)
# with a per-op provider/model/temperature/max_tokens table. Neither file
# holds a secret: config/providers.py only names which env var below carries
# each provider's key, and .env is where the value actually lives - e.g. a
# provider row with api_key_env "OPENAI_API_KEY" reads this file's
# OPENAI_API_KEY, not LLM_API_KEY.
#
# These are paths, and relative ones resolve against the *working directory*:
# in Docker that is /app, so ./config/providers.py means /app/config/providers.py
# INSIDE the container - not next to docker-compose.yml on the host. Since
# 2026-09-10 both files are tracked in git (they name env vars, never hold keys)
# and the Dockerfile copies config/ into the image, so a deployment gets them
# from `docker compose pull` and needs nothing on the box. Changing a model is
# therefore a rebuild-and-push; docker-compose.yml has a commented-out
# ./config:/app/config:ro override for deployments that must diverge.
#
# Setting these to a path that does not exist is the documented way to force the
# single-provider fallback back on - an *unset* variable falls back to the
# ./config default and so does not do it. That is how the api-offline service
# keeps LLM_BACKEND=fake working now that routing ships in the image.
# `curl /healthz | jq .config` reports each resolved path, whether it was found,
# and which mode is in force.
LLMWIKI_PROVIDERS_CONFIG=./config/providers.py
LLMWIKI_OPS_CONFIG=./config/ops.py

# Query-agent skill discovery directory (design v1.4 4.8.2, plan 19.5) -
# outside src/llmwiki, like the two paths above. Read by agent/skills.py: each
# *.md file under it with name/description frontmatter is a skill the query
# agent (only - the compiler's chains/prompts/ is unaffected) can pick, or
# chain, per question. This repository ships two (skills/answer_query.md,
# skills/compare_concepts.md). An absent or empty directory falls back to the
# fixed answer_query prompt - unset this to disable skill invocation entirely.
# Same relative-path caveat as the two above (./skills -> /app/skills in the
# container), but skills/ IS tracked application content, so the Dockerfile
# copies it into the image and no host mount is needed.
AGENT_SKILLS_DIR=./skills

# --- Query graph bounds (Phase 1-D, design 4.9; technical document 3.3) ---
# The query agent is a LangGraph ReAct loop: after the wiki-first retrieval
# the model may call search_wiki / search_chunks / get_page (and search_web,
# below) to gather more evidence before answering. Every bound is code-
# enforced, never a prompt request. 0 skips the loop entirely and gives the
# pre-graph single-call behaviour; each tool call is one extra cheap
# agent_step call (config/ops.py) plus the tool's own cost.
AGENT_MAX_TOOL_CALLS=4
# When the model is *offered* search_web: off (never; the default, no key
# needed), weak (only when the wiki had no strong hit and the chunk fallback
# ran), always. Web results come back as Answer.external_refs - shown to the
# reader as external, never citations - and are capped per question.
AGENT_WEB_SEARCH_POLICY=off
AGENT_MAX_WEB_SEARCHES=1

# --- Web search backend (Phase 1-D) ---
# none builds no searcher at all; tavily (via langchain-tavily, shipped in the
# base install) needs TAVILY_API_KEY from https://app.tavily.com; fake is the
# offline double. Adding another backend is one adapter file under
# src/llmwiki/websearch/ - technical document 5.11.
WEB_SEARCH_BACKEND=none
TAVILY_API_KEY=tvly-...

# Deprecated aliases - still read, removed at milestone N4. If both a new name
# and its alias are set, the new name wins.
#   ANTHROPIC_API_KEY -> LLM_API_KEY
#   LLM_DEFAULT_MODEL -> LLM_MODEL
#   LLM_BACKEND       -> LLM_PROVIDER

# --- Observability: LangSmith tracing (optional) ---
# The langsmith package is always installed (it is a dependency of
# langchain-core); the "[langsmith]" extra only names the contract. Nothing
# here is imported or configured unless LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false                      # true to enable; requires LANGSMITH_API_KEY
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=llmwiki
LANGSMITH_ENDPOINT=                          # blank = LangSmith's default endpoint
# Traces every LLM call - the native Anthropic adapter AND every LangChain
# provider - with full prompts/responses, latency, and run trees. Since Phase
# 1-D the whole query graph is one trace: a root run "answer_query", one child
# per node (retrieve, agent, tools, ...), one LLM run per call named by op.
# With tracing on, Answer.run_id is that root run - the handle POST /feedback
# and `llmwiki feedback` attach a human correction to. Independent of
# LLM_PROVIDER; complements (does not replace) the measured USD cost ledger
# in wiki/_meta/cost.jsonl.
# The dataset scripts/eval_answer.py --push mirrors the golden set to and
# --langsmith evaluates against. Local (--offline) eval needs none of this.
LANGSMITH_EVAL_DATASET=llmwiki-answer-quality

# --- Observability: stdlib logging (process-local, not shipped anywhere) ---
LOG_LEVEL=INFO                               # DEBUG shows which model each compile stage used

# --- Cloudflare (R2 + Vectorize + Workers AI) - see plan sections 6.2-6.4 ---
CF_ACCOUNT_ID=changeme
CF_API_TOKEN=changeme                        # Vectorize Write + Workers AI Read + Workers AI Edit (6.3)
R2_ACCESS_KEY_ID=changeme                    # S3-compatible creds, separate from CF_API_TOKEN (6.2)
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=llmwiki
R2_ENDPOINT_URL=https://changeme.r2.cloudflarestorage.com
VECTORIZE_CHUNKS_INDEX=llmwiki-chunks
VECTORIZE_GISTS_INDEX=llmwiki-gists
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768                            # MUST equal the shape printed by the 6.3 curl

# --- Capture channels (Phase 1, KB design §5) - each is optional; leaving its
# secret blank disables that channel (its router is not mounted). Both are
# webhooks the provider calls, not polling processes - see src/llmwiki/channels/.
TELEGRAM_BOT_TOKEN=                          # from @BotFather; a new bot dedicated to this service
TELEGRAM_WEBHOOK_SECRET=                     # random string; also passed to Telegram's setWebhook:
                                              #   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
                                              #     -d url=https://<public-host>/channels/telegram/webhook \
                                              #     -d secret_token=$TELEGRAM_WEBHOOK_SECRET
MAILGUN_SIGNING_KEY=                         # Mailgun's inbound-parse HMAC signing key; register
                                              # https://<public-host>/channels/email/inbound as the
                                              # route's forward-to URL in Mailgun's dashboard
YOUTUBE_PROXY_URL=                           # http(s)://user:pass@host:port - used for YouTube transcript
                                              # fetches only. YouTube refuses transcript requests from most
                                              # cloud-provider egress IPs (the library raises RequestBlocked),
                                              # so a deployed service needs a residential/rotating proxy here;
                                              # blank = direct request, which works from a laptop. The
                                              # webhooks report a block back to the sender instead of 500ing
                                              # (Telegram/Mailgun would otherwise retry the blocked fetch for hours).

# --- Service ---
INGEST_API_TOKEN=changeme                    # static bearer token for POST /ingest (Phase 0 only)
API_HOST=0.0.0.0                             # 0.0.0.0 so the Windows host can reach WSL2
API_PORT=8010                                # host-facing port (docker-compose maps this to the
                                              # container's internal 8000); also the bind port for
                                              # `llmwiki serve` outside Docker. 8010 because 8000 is
                                              # already assigned on the Hostinger deploy target - see
                                              # docs/deployment-plan-container-hosting.md

# --- Docker Hub (docker-compose.yml image naming) ---
# Read by Compose *interpolation*, not by the application, so a shell export works too
# (and takes precedence over this file). Unset falls back to `local/llmwiki:latest`,
# which builds and runs but cannot be pushed or pulled.
# Tracked here as the release coordinates: bump IMAGE_TAG with each push so
# the tag a box pulls is the one recorded in git, not whatever `latest` was.
DOCKER_USER=thomaschoi                       # Docker Hub account/org that owns the llmwiki repo
IMAGE_TAG=0.1.0                              # the current release; a shell export still overrides

# --- Runtime container (docker-compose.yml `api`, `lint`, `init-data`; Compose interpolation) ---
# The uid/gid the deployed image runs as, and that init-data chowns ./.data to
# before api starts. The default is the image's own non-root user, so a deploy
# box leaves these alone. Set both to DEV_UID/DEV_GID on a dev box that runs the
# `dev` service against the same ./.data, so both can write to it.
API_UID=10001
API_GID=10001

# --- Dev container (docker-compose.yml `dev` service; Compose interpolation) ---
# Only used by `docker compose --profile dev ...`, never by the application or
# by the deployed image. The dev service bind-mounts this working tree, so it
# runs as your own uid/gid to keep files it writes (./.data, .pytest_cache)
# out of root's ownership. Defaults suit a single-user Linux/WSL2 box; check
# with `id -u` / `id -g`.
DEV_PORT=8011                                # host port for the dev container (api uses API_PORT)
DEV_UID=1000
DEV_GID=1000

# --- Cost guardrails (plan section 8.2) ---
COMPILE_MAX_PAGES=5
COMPILE_CANDIDATE_PAGES=8
INGEST_TOKEN_BUDGET=60000
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=400

# --- Backend selection (4.3, 6.7) - swap to the fakes for offline dev and tests ---
STORAGE_BACKEND=r2                           # r2 | local
VECTOR_BACKEND=vectorize                     # vectorize | memory
EMBEDDING_BACKEND=workers_ai                 # workers_ai | fake
LOCAL_STORAGE_PATH=./.data
# The LLM backend switch is LLM_PROVIDER, above - set LLM_PROVIDER=fake to go offline.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=

GOOGLE_API_KEY=
GOOGLE_BASE_URL=

# Real cloud OpenAI only - self-hosted local LLMs use VLLM_*/LLAMACPP_*
# below instead (2026-09-14; previously this row doubled for both, which
# meant a local endpoint and real cloud OpenAI could never both be active).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Phase 1 local LLM (RTX 3090 host): vLLM primary, llama.cpp fallback, each
# its own row in config/providers.py so both - and OPENAI_API_KEY above - can
# be active at once. Point *_BASE_URL at http://<host>:<port>/v1 and *_API_KEY
# at any non-empty placeholder if the server doesn't check one. See
# config/ops.py's commented local-routing example for wiring an op to either.
VLLM_API_KEY=
VLLM_BASE_URL=

LLAMACPP_API_KEY=
LLAMACPP_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=