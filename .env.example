# Copy to .env and fill in real values:  cp .env.example .env
# .env is never committed. See implement-plan.md section 6 for how to obtain each value.

# --- LLM (provider-generic) -----------------------------------------------
# These four names are the shared agentkit-llm contract: the same spelling in
# every repo that consumes the layer, so an .env moves between them unchanged.
# See implement-plan-v1.4.md section 7.6.
LLM_PROVIDER=anthropic                      # see the provider table below
LLM_API_KEY=sk-ant-...                      # whichever provider LLM_PROVIDER names
LLM_MODEL=claude-haiku-4-5                  # a model id that provider offers
LLM_BASE_URL=                               # gateway/proxy or self-hosted endpoint; blank = provider default

# Providers, and the extra each one needs. Anthropic is native (prompt caching
# and measured USD cost); the rest go through LangChain, which reports real
# token counts but no cache tier and no price unless the model is listed in
# src/llmwiki/llm/pricing.py.
#
#   LLM_PROVIDER   install                             LLM_MODEL example
#   anthropic      (built in)                          claude-haiku-4-5
#   openai         pip install "llmwiki[openai]"       gpt-5
#   google         pip install "llmwiki[google]"       gemini-2.5-flash
#   nvidia         pip install "llmwiki[nvidia]"       meta/llama-3.3-70b-instruct
#   deepseek       pip install "llmwiki[deepseek]"     deepseek-chat
#   openrouter     pip install "llmwiki[openrouter]"   anthropic/claude-haiku-4.5
#   fake           (built in)                          - offline double, no key needed
#
# All of them at once: pip install "llmwiki[all-providers]"
# Self-hosted (vLLM, Ollama, LM Studio): LLM_PROVIDER=openai with LLM_BASE_URL
# pointed at the OpenAI-compatible endpoint.

# Wiki-specific, deliberately NOT part of the shared contract:
COMPILE_EXECUTOR_MODEL=claude-haiku-4-5     # set to claude-sonnet-5 to escalate patch generation

# Deprecated aliases - still read, removed at milestone N4. If both a new name
# and its alias are set, the new name wins.
#   ANTHROPIC_API_KEY -> LLM_API_KEY
#   LLM_DEFAULT_MODEL -> LLM_MODEL
#   LLM_BACKEND       -> LLM_PROVIDER

# --- Cloudflare (R2 + Vectorize + Workers AI) - see plan sections 6.2-6.4 ---
CF_ACCOUNT_ID=changeme
CF_API_TOKEN=changeme                        # Vectorize Edit + Workers AI Read (6.3)
R2_ACCESS_KEY_ID=changeme                    # S3-compatible creds, separate from CF_API_TOKEN (6.2)
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=llmwiki
R2_ENDPOINT_URL=https://changeme.r2.cloudflarestorage.com
VECTORIZE_CHUNKS_INDEX=llmwiki-chunks
VECTORIZE_GISTS_INDEX=llmwiki-gists
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768                            # MUST equal the shape printed by the 6.3 curl

# --- Service ---
INGEST_API_TOKEN=changeme                    # static bearer token for POST /ingest (Phase 0 only)
API_HOST=0.0.0.0                             # 0.0.0.0 so the Windows host can reach WSL2
API_PORT=8000

# --- Cost guardrails (plan section 8.2) ---
COMPILE_MAX_PAGES=5
COMPILE_CANDIDATE_PAGES=8
INGEST_TOKEN_BUDGET=60000
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=400

# --- Backend selection (4.3, 6.7) - swap to the fakes for offline dev and tests ---
STORAGE_BACKEND=r2                           # r2 | local
VECTOR_BACKEND=vectorize                     # vectorize | memory
EMBEDDING_BACKEND=workers_ai                 # workers_ai | fake
LOCAL_STORAGE_PATH=./.data
# The LLM backend switch is LLM_PROVIDER, above - set LLM_PROVIDER=fake to go offline.
