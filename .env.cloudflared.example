# Template for the tunnel project's `.env` on the VPS - copy it to `.env` in the
# directory holding docker-compose-cloudflared.yml (renamed docker-compose.yml),
# NOT into llmwiki's directory. Never commit the real value: the token alone
# lets anyone run connectors for this tunnel and receive its traffic.
#
# Cloudflare Zero Trust -> Networks -> Tunnels -> srv-llmwiki -> Configure ->
# "Install and run a connector": the long string after `--token`.
TUNNEL_TOKEN=changeme
